# SPDX-License-Identifier: Apache-2.0
# Which kt build is in use. ONE place.
#
# This file is both sourced by the shell drivers and parsed by
# build_fingerprint.py, so "the site the service imports" and "the site the
# fingerprint hashes" cannot drift apart. Keep it to plain assignments: the
# python side reads KT_SITE_DEFAULT with a literal prefix match, it does not
# run a shell.
#
# Why it exists (2026-09-22): the path used to be written out five times --
# serve_v41_singlecard.sh, run_oncard.sh, run_packed_ab.sh, run_cpu_bench.sh,
# and, worst of all, build_fingerprint.py, where the copy was not even the
# same object: it globbed a *wheel* directory (kt_wheel/*.whl) that has no
# link to the site on PYTHONPATH. Switching the four shell copies to
# kt_site_v2 and missing the fifth left the fingerprint reporting the OLD
# wheel's sha256, so runs on two different builds looked like one build,
# same_build() let their numbers be subtracted, and nothing said a word.
# Now the site is the source and the wheel is derived from it.
#
# To switch builds: change KT_SITE_DEFAULT here, and nothing else. Then re-run
# what §8.2 of oncard/RUNBOOK_dispatch.md says must be re-run -- readings do
# not survive the switch.
KT_SITE_DEFAULT=/workspace/code/dsv4_single_card/vllm_project/build_artifacts/moe_offload_ref/kt_site

# An explicit KT_SITE in the environment wins (that is how the mutation arm and
# any side-by-side check point the tools at another site); it is recorded in
# the fingerprint as an override, never silently.
# shellcheck disable=SC2034
KT_SITE="${KT_SITE:-$KT_SITE_DEFAULT}"
# The wheel directory is DERIVED from the site, never named separately: that
# independence is exactly what failed. kt_site -> kt_wheel, kt_site_v2 ->
# kt_wheel_v2. The wheel is provenance; the site is what gets imported.
KT_WHEEL_DIR="$(dirname "$KT_SITE")/$(basename "$KT_SITE" | sed 's/^kt_site/kt_wheel/')"
export KT_SITE KT_WHEEL_DIR
